@inproceedings{Amershi2019Software,
  title     = {Software Engineering for Machine Learning: A Case Study},
  author    = {Amershi, Saleema and Begel, Andrew and Bird, Christian and DeLine, Robert},
  year      = {2019},
  booktitle = {ICSE},
  abstract  = {We present a study of machine learning workflows in a large software company. We conducted interviews and surveys to understand the engineering practices around ML. Our findings suggest that ML teams face unique challenges in versioning, testing, and deployment. We identify 28 engineering challenges that distinguish ML from traditional software engineering.}
}

@inproceedings{Gillies2016Human,
  title     = {Human-Centred Machine Learning},
  author    = {Gillies, Marco and Fiebrink, Rebecca and Caramiaux, Baptiste and Garcia, Joelle},
  year      = {2016},
  booktitle = {CHI},
  abstract  = {This workshop brought together researchers interested in human-centred approaches to machine learning. We discuss how interactive machine learning can empower users to teach models without requiring expertise in ML. Field study observations with novice users suggest that transparency and control are key design requirements.}
}

@inproceedings{Cai2019Human,
  title     = {Human-Centered Tools for Coping with Imperfect Algorithms During Medical Decision-Making},
  author    = {Cai, Carrie J and Reif, Emily and Hegde, Narayan and Hipp, Jason},
  year      = {2019},
  booktitle = {CHI},
  abstract  = {We conducted a mixed-methods study with 7 pathologists using an imperfect ML model for cancer diagnosis. Our qualitative analysis of think-aloud sessions and a quantitative survey revealed that clinicians develop mental models of AI uncertainty over time. Recommendations: provide calibrated uncertainty estimates and allow model interrogation.}
}

@inproceedings{Bansal2021Does,
  title     = {Does the Whole Exceed Its Parts? The Effect of AI Explanations on Complementary Team Performance},
  author    = {Bansal, Gagan and Wu, Tongshuang and Zhou, Joyce and Fok, Raymond and Nushi, Besmira},
  year      = {2021},
  booktitle = {CHI},
  abstract  = {We ran a controlled experiment (n=138 participants) examining how AI explanations affect human-AI team performance. Our findings show that explanations can help or hurt depending on the AI's accuracy and the task difficulty. We contribute design guidelines for when to show explanations in AI-assisted decision-making.}
}

@article{Yang2018Investigating,
  title     = {Investigating How Experienced UX Designers Effectively Work with Machine Learning},
  author    = {Yang, Qian and Steinfeld, Aaron and Rosé, Carolyn and Zimmerman, John},
  year      = {2018},
  journal   = {TOCHI},
  abstract  = {We conducted an interview study with 11 experienced UX designers who had collaborated with ML engineers. Thematic analysis revealed four major challenges: unpredictability, performance bottlenecks, accountability gaps, and ethical blind spots. We present a framework for UX-ML collaboration.}
}

@inproceedings{Liao2022Connecting,
  title     = {Connecting the Dots in Trustworthy Artificial Intelligence},
  author    = {Liao, Q. Vera and Sundar, S. Shyam},
  year      = {2022},
  booktitle = {FAccT},
  abstract  = {We develop a theoretical framework connecting XAI, fairness, and accountability research. Our conceptual contribution maps the landscape of trustworthy AI and identifies key tensions in operationalising trust. We argue that human-centred evaluation methods are underrepresented in fairness literature.}
}

@inproceedings{Jiang2022Robots,
  title     = {Robots Enact Malignant Stereotypes},
  author    = {Jiang, Ryan and Peng, Sunipa and Kalliamvakou, Eirini},
  year      = {2022},
  booktitle = {FAccT},
  abstract  = {We present an empirical study demonstrating that language-model-powered robots reproduce social stereotypes from pretraining data. A mixed-methods evaluation combining automatic metrics and human annotation (n=42) shows persistent bias across demographic groups. We propose a red-teaming framework for embodied AI.}
}
